APP_NAME=Lootwright
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Explicit HTTP trust boundary. Production must use exact host regexes and proxy CIDRs.
TRUSTED_HOSTS=^localhost$,^127\.0\.0\.1$
TRUSTED_PROXIES=127.0.0.1
APP_RELEASE_SHA=
DEPLOYMENT_LOCKDOWN_MODE=true

# Local Docker/host defaults. Laravel Cloud injects attached PostgreSQL values;
# do not copy these local credentials over Cloud-managed connection variables.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lootwright
DB_USERNAME=lootwright_app
DB_PASSWORD=lootwright-local
DB_SSLMODE=prefer
DB_SSLROOTCERT=
DB_SSLCERT=
DB_SSLKEY=
DB_APPLICATION_NAME=lootwright-local
DB_ADMIN_USERNAME=lootwright_admin
DB_ADMIN_PASSWORD=lootwright-admin-local

# Local Docker uses Redis for session/cache/queue. A minimal Laravel Cloud
# foundation may use database sessions/cache and sync queues until Valkey or a
# managed queue is genuinely required.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Local disks are ephemeral on Laravel Cloud. Do not enable queued artifact
# workflows there until a reviewed durable private object-storage disk exists.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=lootwright_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_SCHEME=tcp
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_HORIZON_DB=3
REDIS_QUEUE_CONNECTION=queue
REDIS_TLS_VERIFY_PEER=false
REDIS_TLS_VERIFY_PEER_NAME=false
REDIS_TLS_CA_FILE=
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=150

HORIZON_PATH=horizon
HORIZON_PREFIX=lootwright_horizon:
HORIZON_REDIS_CONNECTION=horizon-metadata
HORIZON_DASHBOARD_ENABLED=true

# Required only for the protected /ready diagnostics endpoint. /up is the
# dependency-free health endpoint. /ready currently checks PostgreSQL and a
# Redis-compatible service, so it is expected to fail when Cloud Valkey is absent.
READINESS_TOKEN=

# Emergency policy controls. The admin token protects evidence management only.
POLICY_GLOBAL_KILL_SWITCH=false
POLICY_ADMIN_ENABLED=false
POLICY_ADMIN_TOKEN=

# Independent emergency switches. Funding remains code-disabled regardless of environment.
IMPORTS_ENABLED=true
RULESETS_ENABLED=true
EXTERNAL_LINKS_ENABLED=true
OUTBOUND_NETWORK_ENABLED=false
AUTH_REQUIRE_VERIFIED_EMAIL=false

# Funding is a policy-gated operator request, not a payment switch. It remains
# disabled unless reviewed decision/evidence metadata and the Policy Gate allow it.
FUNDING_ENABLED=false
FUNDING_POLICY_DECISION_ID=
FUNDING_POLICY_DECISION_DATE=
FUNDING_EVIDENCE_RECORD_ID=
FUNDING_OPERATOR_ACKNOWLEDGED=false
FUNDING_DISCLOSURE_VERSION=
FUNDING_COST_COMPUTE_MONTHLY_CENTS=3500
FUNDING_COST_BACKUPS_MONTHLY_CENTS=1000
FUNDING_COST_OPERATIONS_MONTHLY_CENTS=1000
FUNDING_LOW_ANALYSES_PER_MONTH=1000
FUNDING_BASE_ANALYSES_PER_MONTH=10000
FUNDING_HIGH_ANALYSES_PER_MONTH=50000

# Normalized PoB imports are encrypted and retained only with explicit consent.
POB_IMPORT_RETENTION_HOURS=24
POB_IMPORT_MAX_RETENTION_HOURS=168

# Encrypted raw queue payloads expire even if a worker never claims them.
ANALYSIS_RAW_ARTIFACT_TTL_MINUTES=60
ANALYSIS_RETENTION_DAYS=30
AI_AUDIT_RETENTION_DAYS=30
DELETED_SESSION_TOMBSTONE_DAYS=7

# Optional AI remains off until Policy Gate review explicitly allows it. Laravel
# Cloud boot, health checks, migrations, and deterministic fallback need no key.
OPENAI_ENABLED=false
OPENAI_LIVE_EVALS_ENABLED=false
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-5.4-nano
OPENAI_EXPLANATION_MODEL=gpt-5.4-nano
OPENAI_PROMPT_TEMPLATE_VERSION=2026-08-15.1
OPENAI_MAX_INPUT_TOKENS=4000
OPENAI_INTENT_MAX_OUTPUT_TOKENS=500
OPENAI_EXPLANATION_MAX_OUTPUT_TOKENS=900
OPENAI_TIMEOUT_SECONDS=15
OPENAI_CONNECT_TIMEOUT_SECONDS=5
OPENAI_MAX_RETRIES=2
OPENAI_CACHE_TTL_SECONDS=3600
OPENAI_USER_DAILY_BUDGET_MICRO_USD=25000
OPENAI_IP_DAILY_BUDGET_MICRO_USD=50000
OPENAI_GLOBAL_DAILY_BUDGET_MICRO_USD=500000
OPENAI_MONTHLY_CIRCUIT_BREAKER_MICRO_USD=5000000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lootwright.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

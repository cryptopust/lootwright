{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "lootwright",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write resources/ tests/e2e/ playwright.config.ts vite.config.ts vitest.config.ts",
        "format:check": "prettier --check resources/ tests/e2e/ playwright.config.ts vite.config.ts vitest.config.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:update": "playwright test --update-snapshots"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.13.5",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.11",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "happy-dom": "^20.11.2",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript-eslint": "^8.23.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.7.0",
        "@inertiajs/vue3": "^3.7.0",
        "@tailwindcss/vite": "^4.1.11",
        "@vitejs/plugin-vue": "^6.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.5",
        "laravel-vite-plugin": "^3.1",
        "reka-ui": "^2.10.3",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vue": "^3.5.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.3",
        "@rollup/rollup-linux-x64-gnu": "4.62.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
